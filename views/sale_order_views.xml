<odoo>
    <data>
        <record id="sale_order_form_inherit" model="ir.ui.view">
            <field name="name">sale.order.form.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                
                <xpath expr="//notebook" position="inside">
                    <page name="denied" string="Motivos de cancelación" invisible="state != 'cancel'">
                        <group>
                            <group string="Motivos de cancelación de venta">
                                <field name="data_availability"/>
                                <field name="data_delivery_time"/>
                                <field name="data_sale_price"/>
                                <field name="data_other"/>
                                <field name="data_message" invisible="not data_other"/>
                            </group>
                        </group>
                    </page>
                </xpath>

                <!-- <xpath expr="//page[@name='other_information']//group[@name='sale_shipping']" position="inside">
                    <field name="data_ready_to_pick" widget="boolean_toggle" readonly="1"/>
                </xpath> -->

                <xpath expr="//div[hasclass('oe_title')]" position="before">
                    <div class="badge rounded-pill text-bg-success float-end fs-6 border-0 mt-2" 
                        style="clear: right;"
                        invisible="not data_ready_to_pick">
                        <span>Listo para recolectar</span>
                    </div>
                </xpath>

            </field>
        </record>

        <record id="sale_order_form_inherit_guide" model="ir.ui.view">
            <field name="name">sale.order.form.inherit_guide</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="madkting.view_order_form_inherit"/> 
            <field name="arch" type="xml">
                <xpath expr="//field[@name='yuju_carrier_tracking_ref']" position="attributes">
                    <attribute name="readonly">0</attribute>
                </xpath>          
            </field>
        </record>
    </data>
</odoo>