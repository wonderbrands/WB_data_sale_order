<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_sale_order_attachment_list" model="ir.ui.view">
            <field name="name">sale.order.attachment.list</field>
            <field name="model">sale.order.attachment</field>
            <field name="arch" type="xml">
                <list>
                    <field name="file_name"/>
                    </list>
            </field>
        </record>

        <record id="view_sale_order_attachment_form" model="ir.ui.view">
            <field name="name">sale.order.attachment.form</field>
            <field name="model">sale.order.attachment</field>
            <field name="arch" type="xml">
                <form string="Adjuntar Guía">
                    <sheet>
                        <group>
                            <group>
                                <field name="attachment" filename="file_name" widget="binary" string="Subir Documento"/>
                                <field name="file_name" invisible="True"/>
                            </group>
                        </group>
                        
                        <div invisible="not attachment" class="alert alert-info" role="alert" style="margin-bottom: 15px; margin-top: 10px;">
                            <i class="fa fa-info-circle" style="margin-right: 5px;"/>
                            <strong>Aviso:</strong> La previsualización del documento estará disponible una vez que guarde la <b>Orden de Venta</b> principal.
                        </div>

                        <group invisible="not attachment">
                             <field name="attachment" widget="pdf_viewer" nolabel="1" colspan="2"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="wb_data_sale_order_guias_inherit" model="ir.ui.view">
            <field name="name">wb.data.sale.order.guias.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Datos necesarios" name="attachments">
                        <group>
                            <group>
                                <field name="data_tracking_readwrite" readonly="0" string="Número de guía"/>
                                <field name="data_carrier_selection_relational" readonly="0" string="Paquetería o Carrier" options="{'no_create': True, 'no_open': True}"/>
                            </group>
                        </group>
                        
                        <field name="attachments"/>
                    </page>
                </xpath>
                
                <xpath expr="//notebook" position="inside">
                    <page string="Etiquetas internas" name="ei_tags"> <field name="ei">
                             <list>
                                <field name="display_name_custom"/>
                                <field name="on_bin"/>
                                <field name="on_dock" />
                                <field name="dispatched" />
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>